 * User: cherrynoize
 * https://github.com/cherrynoize/dotfiles
 *
 * Generated by wpgtk *
 * Do not edit directly! */


/*****----- Global Properties -----*****/
* {
  /********----- apperance ----********/
  radius:         3px;

  /********------- font -------********/
  font:           "JetBrainsMono NF Bold 10";

  /*******------ palette ------********/
  blue:           #6272a4;
  purple:         #bd93f9;
  light-grey:     #bbc5d7;

  /******----- colorscheme -----******/
//primary:        #1f1d2f;
  primary:        #D96960;
  secondary:      #421425;
  bg:             #1c0910;
//bg-alt:         #ffba4c;
  bg-alt:         #ffbb6d;
  bg-trans:       #1c091063;
  fg:             #ffe6e6;
//selected:       @light-grey;
  selected:       #421425;
  accent:         #F2924B;
  highlight:      #f2c7c7;
  active:         @selected;
  urgent:         @accent;

  /*******----- backgrounds -----******/
  selected-bg:    @accent;

  /********------ images ------********/
  img:            url("~/.current-wallpaper", both);
  img-width:      url("~/.current-wallpaper", width);
  img-height:     url("~/.current-wallpaper", height);

  /******------ properties ------******/
  background-color: @bg;
  text-color: @fg;
}
