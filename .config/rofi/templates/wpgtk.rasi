 * User: cherrynoize
 * https://github.com/cherrynoize/dotfiles
 *
 * Generated by wpgtk *
 * Do not edit directly! */


/*****----- Global Properties -----*****/
* {
  /********----- apperance ----********/
  radius:         3px;

  /********------- font -------********/
  font:           "JetBrainsMono NF Bold 10";

  /*******------ palette ------********/
  blue:           #6272a4;
  purple:         #bd93f9;
  light-grey:     #bbc5d7;

  /******----- colorscheme -----******/
//primary:        #1f1d2f;
  primary:        #AD5354;
  secondary:      #1d103a;
  bg:             #0A0613;
//bg-alt:         #ffa184;
  bg-alt:         #1a358f;
  bg-trans:       #0A061363;
  fg:             #cdd1f9;
//selected:       @light-grey;
  selected:       #1d103a;
  accent:         #DE8877;
  highlight:      #979ab8;
  active:         @selected;
  urgent:         @accent;

  /*******----- backgrounds -----******/
  selected-bg:    @accent;

  /********------ images ------********/
  img:            url("~/.current-wallpaper", both);
  img-width:      url("~/.current-wallpaper", width);
  img-height:     url("~/.current-wallpaper", height);

  /******------ properties ------******/
  background-color: @bg;
  text-color: @fg;
}
