/* Generated by wpgtk *
 * Do not edit directly! */

* {{
    border: none;
    border-radius: 0px;
    font-family: "JetBrainsMono Nerd Font";
    font-weight: bold;
    font-size: 10px;
}}

window#waybar {{
    min-height: 10px;
    background: @bar-bg;
}}

widget > * {{
    padding: 0 4px;
    background-color: transparent;
}}

tooltip {{
    background: @main-bg;
    color: @main-fg;
    border-radius: 7px;
    border-width: 0px;
}}

#workspaces,
#clock,
#tray,
#feed,
#system {{
    margin: 4px 0;
    padding: 0 10px;
    border-radius: {bar-radius};
    border: 1px solid @brdr;
    background: @main-bg;
    color: @main-fg;
}}

#workspaces button {{
    box-shadow: none;
	text-shadow: none;
    border-radius: 9px;
    margin: 3px;
    padding: 0 8px 0 5px;
    color: @main-fg;
    animation: ws_normal 20s ease-in-out 1;
}}

#workspaces *:first-child {{
    margin-left: 0;
}}

#workspaces *:last-child {{
    margin-right: 0;
}}

#workspaces button:not(:first-child).active,
#workspaces button:not(:first-child):hover {{
    margin: 3px 4px;
}}

#workspaces button:not(:last-child).active,
#workspaces button:not(:last-child):hover {{
    margin: 3px 4px;
}}

#workspaces button.active {{
    background: @wb-act-bg;
    color: @wb-act-fg;
    animation: ws_active 20s ease-in-out 1;
    transition: all 0.4s cubic-bezier(.55,-0.68,.48,1.682);
}}

#workspaces button:hover {{
    background: @wb-hvr-bg;
    color: @wb-hvr-fg;
    animation: ws_hover 20s ease-in-out 1;
    transition: all 0.3s cubic-bezier(.55,-0.68,.48,1.682);
}}

#tray,
#network {{
    padding: 0 2px;
}}

#tray menu * {{
    min-height: 16px;
}}

#tray menu separator {{
    min-height: 10px;
}}

#tray > .passive {{
    -gtk-icon-effect: dim;
}}

#tray > .needs-attention {{
    -gtk-icon-effect: highlight;
    color: {urgent};
}}

#custom-wallpaper {{
    padding-right: 7px;
}}

#battery.charging, #battery.plugged {{
    color: {success};
}}

#battery.warning:not(.charging) {{
    color: {warning};
}}

/* Using steps() instead of linear as a timing function to limit cpu usage */
#battery.critical:not(.charging) {{
    color: {urgent};
    animation-name: blink;
    animation-duration: 0.6s;
    animation-timing-function: steps(15);
    animation-iteration-count: infinite;
    animation-direction: alternate;
}}

@keyframes blink {{
    to {{
        color: @main-fg;
    }}
}}
