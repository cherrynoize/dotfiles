#!/bin/sh
# author | cherrynoize

if [ -n "$WAYLAND_DISPLAY" ]; then
  case "$1" in
    "")
      if pidof hypridle > /dev/null; then
        killall hypridle && exit 1
      else
        hypridle & disown
      fi
      ;;
    on)
      pidof hypridle || hypridle & disown
      ;;
    off)
      pidof hypridle > /dev/null && killall hypridle && exit 1
      ;;
  esac
else
  toggle-dpms "$@"
fi
