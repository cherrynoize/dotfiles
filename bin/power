#!/bin/sh

case "$1" in
  off|shutdown)
    systemctl poweroff
    ;;
  reboot)
    systemctl reboot
    ;;
  freeze|hibernate)
    systemctl hibernate
    ;;
  hybrid-sleep)
    systemctl hybrid-sleep
    ;;
  suspend-then-hibernate|deep-sleep)
    systemctl suspend-then-hibernate
    ;;
  sleep|suspend)
    systemctl suspend
    ;;
  exit|logout)
    exit-session
    ;;
  lock|screenlock)
    screenlock &
    ;;
esac
