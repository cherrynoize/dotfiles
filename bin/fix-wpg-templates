#!/usr/bin/env bash
# clear old wpg template links and create new ones
# author: cherrynoize
# https://github.com/cherrynoize/dotfiles

templates_dir="$HOME/.config/wpg/templates"
cd "$templates_dir" || exit 4

declare -a old_links=(*)
declare -A new_links=(
  ["../../bspwm/colorschemes/current"]="bspwm"
  ["../../dunst/themes/earth/dunstrc"]="dunst-earth"
  ["../../dunst/themes/galaxy/dunstrc"]="dunst-galaxy"
  ["../../dunst/themes/nightsky/dunstrc"]="dunst-nightsky"
  ["../../dunst/themes/tokyonight/dunstrc"]="dunst-tokyonight"
  ["../../eww/schemes/appearance.scss"]="eww"
  ["../../waybar/themes/sleek/theme.css"]="waybar-sleek"
  ["../../waybar/themes/astro/theme.css"]="waybar-astro"
  ["../../../.local/share/themes/FlatColor/gtk-2.0/gtkrc"]="gtk2"
  ["../../../.local/share/themes/FlatColor/gtk-3.0/gtk.css"]="gtk3.0"
  ["../../../.local/share/themes/FlatColor/gtk-3.20/gtk.css"]="gtk3.20"
  ["../../polybar/themes/current/colors.ini"]="poly"
  ["../../eww/scripts/powersave-tray"]="powersave-tray"
  ["../../rofi/templates/wpgtk.rasi"]="rofi"
  ["../../swaylock/themes/wpgtk"]="swaylock"
)

# clear old symlinks
for link in "${old_links[@]}"; do
  # if it's a symlink remove it
  if [ -L "$link" ]; then
    rm "$link"
  fi
done

# create new ones
for dest in "${!new_links[@]}"; do
  linkname="${new_links[$dest]}"
  ln -s "$dest" "$linkname"
done
