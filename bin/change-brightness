#!/usr/bin/env bash
# change brightness level and displays
# notification
# author | cherrynoize

# Available commands are
# |  up  |
# | down |
# |  to  |
# |  on  |
# | off  |

step=10
transition=450000 # time in microseconds

[ -n "$2" ] && step="$2"

function get_brightness {
  brillo
}

function send_notification {
  brightness="$(get_brightness)"
  brightness="$((brightness*95/100))" # Resize to better fit icon on 100%
  # Send notification
  notify-percent -a changeBrightness -m compact "$brightness" "☼"
}

case $1 in
  up)
    # Turn brightness up
    brillo -u "$transition" -A "$step"
    send_notification
    ;;
  down)
    # Turn brightness down
    brillo -u "$transition" -U "$step"
    send_notification
    ;;
  to)
    # Set brightness to value
    # Sends notification only if no additional argument is passed
    brillo -u "$transition" -S "$2"
    send_notification
    ;;
  on)
    # Turn screen on
    screen-on
    ;;
  off)
    # Turn screen off
    screen-off
    ;;
esac
